# ADLAYER — copy to .env and fill. Everything degrades gracefully when absent.

# ── Answer engines (measurement — reused from CITED engine) ──────────────────
OPENAI_API_KEY=            # primary: Responses API w/ web_search, url_citation annotations
OPENROUTER_API_KEY=        # fallback: perplexity/sonar
ANTHROPIC_API_KEY=         # generation + classification

# ── Terac (MANDATORY for hackathon eligibility) ──────────────────────────────
# Signup: https://terac.com/r/rGi7O0EfkRbzmiElg8kRjES5W2JrKNYc
TERAC_API_KEY=

# ── Stripe (gates Best Overall Agent-Run Company, $2,500) ────────────────────
# Payment Link with "Customer chooses price". Use the SAME link all day —
# a new link mid-event means organizers' revenue tracking misses it.
STRIPE_PAYMENT_LINK=
# Restricted key: Balance=Read, Charges=Read, everything else None.
# NEVER put an sk_ key here. Only rk_.
STRIPE_RESTRICTED_KEY=

# ── Pioneer / Fastino (GLiGuard moderation, GLiNER2 extraction) ──────────────
# https://agent.pioneer.ai — promo ZeroHumanHack0826
PIONEER_API_KEY=

# ── Superserve (agent sandboxes) ─────────────────────────────────────────────
SUPERSERVE_API_KEY=

# ── Band (agent coordination room) ───────────────────────────────────────────
# https://www.band.ai — code HACKBANDAUG26
BAND_API_KEY=
BAND_ROOM_ID=

# ── Render (hosting + Workflows) ─────────────────────────────────────────────
RENDER_API_KEY=

# ── Safety flags. All side effects are OFF by default. ───────────────────────
# Set to 1 only when you mean it.
LIVE_SERVE=0               # write to a real publisher llms.txt
LIVE_MEASURE=0             # hit answer engines (costs money)
LIVE_STUDY=0               # launch a paid Terac study
