{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  // engine/ is working, previously-verified code ported from CITED. It was
  // written under a looser config than this one (noUncheckedIndexedAccess in
  // particular) and produces ~39 errors that are strictness noise, not bugs.
  // Excluded from the strict gate so `npm run typecheck` means something for
  // OUR code. Do not "fix" engine/ mid-hackathon — it works and it is tested.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "web/**", "publishers/**", "engine/**"]
}
